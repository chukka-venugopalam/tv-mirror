<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">HelloApp</string>

    <string name="hello_button">Hello</string>
    <string name="hello_toast">Hello!</string>
    <string name="refresh_button">Refresh</string>

    <string name="header_title">USB TV Detector</string>
    <string name="header_subtitle">USB detection + ADB test tap</string>
    <string name="section_technical">Technical details</string>

    <!-- Safe default / fallback state (nothing connected) -->
    <string name="status_title_default">NO USB DEVICE CONNECTED</string>
    <string name="tv_name_default">Waiting for a connection…</string>
    <string name="tv_description_default">Plug your phone into your TV with a USB-C cable and tap Refresh.</string>

    <!-- TV identified (phone is USB host) -->
    <string name="status_tv_detected">TV DETECTED</string>
    <string name="tv_detected_description" formatted="false">Connected in USB host mode. VID 0x%1$s, PID 0x%2$s — this is likely your TV.</string>

    <!-- Unidentified device in host mode -->
    <string name="status_usb_host">USB DEVICE CONNECTED (HOST MODE)</string>
    <string name="usb_host_description">A USB device is connected, but it could not be clearly identified as a TV. See the technical details below.</string>

    <!-- Android Open Accessory (AOA) -->
    <string name="status_accessory">USB ACCESSORY CONNECTED</string>
    <string name="accessory_description">Connected via the Android Open Accessory (AOA) protocol.</string>

    <!-- Phone is the USB peripheral (e.g. plugged into a TV's USB port) -->
    <string name="status_usb_connected">USB CONNECTED</string>
    <string name="peripheral_name">Connected to a USB host (phone is the USB device)</string>
    <string name="peripheral_description">Your phone is in device/peripheral mode, so it cannot read the host\'s (TV\'s) name. See the setup notes for the configuration that lets the phone identify the TV.</string>

    <!-- Stage 3: ADB test tap through the laptop relay -->
    <string name="stage3_title">Stage 3 - ADB Test Tap</string>
    <string name="stage3_subtitle">Sends one tap to the TV through the relay on your laptop (tools/relay.py). USB detection above is unaffected.</string>
    <string name="relay_url_label">Relay URL (laptop running relay.py)</string>
    <string name="relay_url_default">http://127.0.0.1:8080</string>
    <string name="tap_x_hint">X (default 960)</string>
    <string name="tap_y_hint">Y (default 540)</string>
    <string name="tap_x_default">960</string>
    <string name="tap_y_default">540</string>
    <string name="send_tap_button">Send Test Tap</string>
    <string name="tap_result_default">Not sent yet. Start tools/relay.py on your laptop, then tap Send Test Tap.</string>
    <string name="tap_sending" formatted="false">Sending tap to %1$s …</string>
</resources>
